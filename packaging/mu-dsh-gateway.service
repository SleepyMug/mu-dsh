[Unit]
Description=mu-dsh gateway and LLM relay
Documentation=file:///opt/mu-dsh/README.md
BindsTo=mu-dsh.service
After=mu-dsh.service

[Service]
Type=simple
User=mu-dsh
Group=mu-dsh
ExecStart=@NODE@ /opt/mu-dsh/gateway/src/main.ts
# Also restarts the gateway after it exits on a listen-address change.
Restart=always
RestartSec=1s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# To listen on a port below 1024, uncomment:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
